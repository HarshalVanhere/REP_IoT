[Unit]
Description=Industry 4.0 CNC Monitoring Backend Service
After=network.target mysql.service

[Service]
Type=simple
# Change to the appropriate username on the Raspberry Pi (usually 'pi' or your custom user)
User=pi
WorkingDirectory=/home/pi/REP_IoT/backend
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=cnc-monitor-backend

# Production environment variables
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=DB_HOST=127.0.0.1
Environment=DB_PORT=3306
Environment=DB_NAME=cnc_dashboard
Environment=DB_USER=root
Environment=DB_PASSWORD=your_mysql_password
Environment=MQTT_PORT=1883

[Install]
WantedBy=multi-user.target
