[Unit]
Description=REP_IoT CNC Monitoring Backend Service
After=network.target mysql.service

[Service]
Type=simple
# On the Oracle Cloud "Cloud" tier VM: the default cloud-init user is "ubuntu".
# On a Raspberry Pi "Edge Gateway": change both lines below back to your Pi's user
# (usually "pi") and its equivalent path.
User=ubuntu
WorkingDirectory=/home/ubuntu/REP_IoT/backend
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=rep-iot-backend

# All configuration - including secrets (DB_PASSWORD, JWT_SECRET, SYNC_API_KEY,
# MQTT_PASSWORD) - lives in backend/.env, never in this version-controlled unit file.
# Copy deploy/env.production.template (Cloud tier) or backend/.env.example (Edge Gateway)
# to backend/.env on this host and fill it in before starting this service.
EnvironmentFile=/home/ubuntu/REP_IoT/backend/.env

[Install]
WantedBy=multi-user.target
