PORT=5000
NODE_ENV=development

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cnc_dashboard
# Set DB_SSL=true for a managed MySQL host that enforces TLS (e.g. Aiven's free tier). Leave
# unset for a local/on-prem MySQL (Oracle VM, Raspberry Pi) with no TLS. DB_SSL_CA_PATH points
# to the CA certificate file the provider gives you (e.g. Aiven's downloaded ca.pem) - omit it
# only if the provider uses a publicly-trusted CA.
DB_SSL=false
DB_SSL_CA_PATH=

# --- Auth (required) ---
# Signs session tokens. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; falls back to an insecure dev-only default otherwise.
JWT_SECRET=

# Comma-separated list of allowed dashboard origins (e.g. https://plant.example.com).
# Required in production; wide open in development for convenience.
CORS_ORIGIN=

# --- Embedded MQTT broker ---
MQTT_PORT=1883
# Shared credentials any MQTT client (ESP32, Pi gateway) must present to publish.
# Leave unset only for local development - the broker accepts unauthenticated
# publishes without these, which is unsafe on a real plant network.
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Edge Gateway (Raspberry Pi wired to one physical machine via USB serial) ---
IS_EDGE_GATEWAY=false
# The machine ID (from the "machines" table) that THIS gateway's ESP32 is wired to.
# Every Pi+ESP32 deployment gets its own value here - never hardcode it in source.
GATEWAY_MACHINE_ID=
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200
# Cloud backend URL this gateway syncs offline-buffered data to, and the shared key
# both sides must agree on for /api/sync/data (machine-to-machine, not a user login).
CLOUD_BACKEND_URL=
SYNC_API_KEY=
