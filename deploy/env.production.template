# Template for backend/.env on the Oracle Cloud VM ("Cloud" tier of the system).
# Copy to backend/.env on the VM and fill in the placeholders below - never commit the
# filled-in version. This is the counterpart to backend/.env.example, with production values.

PORT=5000
NODE_ENV=production

# --- Database ---
# MySQL runs on this same VM (see deploy/bootstrap.sh) - always 127.0.0.1, never a remote host.
DB_HOST=127.0.0.1
DB_PORT=3306
# Dedicated app user created by bootstrap.sh, scoped to cnc_dashboard only - never root.
DB_USER=cnc_app
DB_PASSWORD=<REPLACE_WITH_GENERATED_DB_PASSWORD>
DB_NAME=cnc_dashboard

# --- Auth (required) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<REPLACE_WITH_GENERATED_JWT_SECRET>

# Your real dashboard domain(s), comma-separated if more than one. Must match exactly
# (scheme + host), e.g. https://cnc.example.com - no trailing slash.
CORS_ORIGIN=https://<REPLACE_WITH_YOUR_DOMAIN>

# --- Embedded MQTT broker ---
# Local-only on this deployment (nginx/Oracle Security List never expose 1883 publicly) -
# still requires credentials so a stray local process can't publish unauthenticated.
MQTT_PORT=1883
MQTT_USERNAME=cnc_broker
MQTT_PASSWORD=<REPLACE_WITH_GENERATED_MQTT_PASSWORD>

# --- Edge Gateway settings (NOT used on this box) ---
# This VM IS the Cloud tier - it never runs as an Edge Gateway itself.
IS_EDGE_GATEWAY=false
GATEWAY_MACHINE_ID=
SERIAL_PORT=
SERIAL_BAUD=
CLOUD_BACKEND_URL=
# Shared secret Edge Gateways (Raspberry Pi field units) must present to POST /api/sync/data
# and GET /api/sync/machine-config/:id. Generate the same way as JWT_SECRET above, then copy
# this exact value into each Edge Gateway's own backend/.env as SYNC_API_KEY.
SYNC_API_KEY=<REPLACE_WITH_GENERATED_SYNC_API_KEY>
