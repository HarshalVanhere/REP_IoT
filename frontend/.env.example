# API and WebSocket endpoints configuration.
# Leave blank to dynamically connect to the hosting server (recommended for Pi gateway & relative deployment).
VITE_API_URL=
VITE_WS_URL=

# Kiosk auto-login (edge-gateway Pi builds ONLY - leave blank on the cloud/Vercel build).
# The /operator touchscreen view logs in automatically as this account instead of showing a
# login form, so operators don't type a password at the machine. Use a dedicated, low-privilege
# "Operator" role account created via Admin > User Profiles (e.g. KIOSK-1313) - never a shared
# Admin login. Baking a password into a frontend build is only acceptable because this account
# has no permissions beyond stop/resume for its own station.
VITE_KIOSK_LOGIN_ID=
VITE_KIOSK_PASSWORD=